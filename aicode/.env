APP_NAME=dev-team-rag-agent
ENV=development

DATABASE_URL=sqlite:///./backend/db/app.db

SECRET_KEY=dev-team-rag-agent-secret-key-2026-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 本地模型配置（已弃用，保留兼容）
MODEL_PATH=models/qwen2-7b-chat-q4_0.gguf
MODEL_NAME=qwen2-7b-chat
MAX_TOKENS=2048
TEMPERATURE=0.7

# ==================== LLM API 配置（可切换） ====================
# 选择一个服务商，注释掉另一个即可切换

# 方案一：七牛云 AI API（推荐）
# 申请地址: https://developer.qiniu.com/aitokenapi
# DEEPSEEK_API_KEY=
# DEEPSEEK_API_BASE=https://api.qnaigc.com/v1
# DEEPSEEK_MODEL=deepseek-v3

# 方案二：DeepSeek 原生 API
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 通用参数（两个服务商共用）
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_TIMEOUT=60

VECTOR_STORE_PATH=vector_data/
COLLECTION_NAME=rag_documents
EMBEDDING_DIMENSION=512
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_MODEL_PATH=models/embedding
EMBEDDING_DEVICE=cpu

MAX_FILE_SIZE=50MB
SUPPORTED_EXTENSIONS=.pdf,.docx,.md,.xlsx,.png,.jpg,.jpeg

# 邮件（SMTP）
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USERNAME=123349332@qq.com
SMTP_PASSWORD=
SMTP_USE_TLS=true

# 第三方办公用品系统
SUPPLY_API_URL=http://localhost:8001/api/v1/supply/application